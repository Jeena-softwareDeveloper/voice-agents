datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  TENANT_STAFF
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ServiceApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum LeadStatus {
  NEW_LEAD
  AI_CONTACTED
  QUALIFIED
  INTERESTED
  MEETING_SCHEDULED
  NEGOTIATION
  WON
  LOST
}

enum InterestLevel {
  LOW
  MEDIUM
  HIGH
  IMMEDIATE
}

enum CallStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
  CANCELLED
}

enum IntegrationProvider {
  WHATSAPP
  FACEBOOK_META
  GMAIL
  GOOGLE_CALENDAR
}

enum IntegrationStatus {
  CONNECTED
  NOT_CONNECTED
  ERROR
  EXPIRED
}

enum CallOutcome {
  ANSWERED
  NO_ANSWER
  BUSY
  FAILED
  INTERESTED
  NOT_INTERESTED
  CALLBACK_REQUESTED
  DEMO_REQUESTED
  QUALIFIED
  OPTED_OUT
}

enum FollowUpType {
  CALLBACK
  DEMO
  SITE_VISIT
  SALES_CALL
  GENERAL
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  OVERDUE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PENDING
  OVERDUE
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum ValidationStatus {
  VALID
  INVALID
  DUPLICATE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole      @default(TENANT_STAFF)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships       TenantMembership[]
  pipelineHistories SalesPipelineHistory[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Tenant {
  id                   String        @id @default(uuid())
  name                 String
  slug                 String        @unique
  email                String
  phone                String
  businessType         String
  country              String        @default("India")
  state                String
  city                 String
  status               TenantStatus  @default(PENDING)
  aiCallingEnabled     Boolean       @default(true)
  monthlyCallingLimit  Int           @default(500)
  usedCallingMinutes   Decimal       @default(0) @db.Decimal(10, 2)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  memberships       TenantMembership[]
  invitations       TenantInvitation[]
  businessProfile   TenantBusinessProfile?
  subscription      Subscription?
  callingSettings   TenantCallingSetting?
  services          Service[]
  serviceAiConfigs  ServiceAiConfig[]
  contacts          Contact[]
  leads             Lead[]
  importBatches     LeadImportBatch[]
  calls             Call[]
  followUps         FollowUp[]
  pipelineHistories SalesPipelineHistory[]
  customers         Customer[]
  usageLedgers      AiUsageLedger[]
  invoices          Invoice[]
  payments          Payment[]
  auditLogs         AuditLog[]
  sarvamVoiceSessions SarvamVoiceSession[]
  agentConfigurations TenantAgentConfiguration[]
  followUpStages      ServiceFollowUpStage[]
  serviceMarketingMaterials ServiceMarketingMaterial[]
  integrations        TenantIntegration[]

  @@map("tenants")
}

model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      String   @default("ADMIN")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_memberships")
}

model TenantInvitation {
  id        String           @id @default(uuid())
  tenantId  String
  email     String
  token     String           @unique
  expiresAt DateTime
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_invitations")
}

model TenantBusinessProfile {
  id                 String   @id @default(uuid())
  tenantId           String   @unique
  businessName       String
  category           String
  description        String   @db.Text
  website            String?
  address            String?
  operatingLocations String?
  primaryObjective   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_business_profiles")
}

model Subscription {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  planName            String   @default("Enterprise AI Pro")
  status              String   @default("ACTIVE")
  callingLimitMinutes Int      @default(1000)
  validityUntil       DateTime
  initialCredits      Decimal  @default(0) @db.Decimal(10, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model TenantCallingSetting {
  id                        String   @id @default(uuid())
  tenantId                  String   @unique
  startHour                 Int      @default(9)
  endHour                   Int      @default(20)
  maxDailyCalls             Int      @default(500)
  maxRetries                Int      @default(3)
  retryIntervalMinutes      Int      @default(120)
  timezone                  String   @default("Asia/Kolkata")
  isAutomatedCallingEnabled Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_calling_settings")
}

model Service {
  id             String                @id @default(uuid())
  tenantId       String
  name           String
  category       String
  description    String                @db.Text
  location       String?
  pricingInfo    String?
  additionalInfo String?               @db.Text
  marketLocation String?
  extractedInfo  Json?
  approvalStatus ServiceApprovalStatus @default(PENDING_APPROVAL)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceAiConfig    ServiceAiConfig?
  leads              Lead[]
  calls              Call[]
  customers          Customer[]
  marketingMaterials ServiceMarketingMaterial[]
  followUpStages     ServiceFollowUpStage[]
  followUps          FollowUp[]

  @@unique([tenantId, name])
  @@map("services")
}

model AiConversationTemplate {
  id                     String   @id @default(uuid())
  name                   String
  description            String   @db.Text
  industry               String
  openingIntro           String   @db.Text
  instructions           String   @db.Text
  qualificationQuestions Json
  approvedResponses      Json
  objectionHandling      Json
  closingStatement       String   @db.Text
  defaultLanguage        String   @default("hi-IN")
  defaultVoice           String   @default("meera")
  version                Int      @default(1)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  serviceAiConfigs ServiceAiConfig[]

  @@map("ai_conversation_templates")
}

model ServiceAiConfig {
  id                     String   @id @default(uuid())
  tenantId               String
  serviceId              String   @unique
  templateId             String?
  openingIntro           String   @db.Text
  companyIdentity        String
  serviceDescription     String   @db.Text
  instructions           String   @db.Text
  qualificationQuestions Json
  approvedResponses      Json
  objectionHandling      Json
  talkingPoints          Json?
  faqs                   Json?
  language               String   @default("hi-IN")
  voice                  String   @default("meera")
  maxDurationSeconds     Int      @default(300)
  closingStatement       String   @db.Text
  escalationPolicy       String?  @db.Text
  version                Int      @default(1)
  status                 String   @default("APPROVED")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service  Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  template AiConversationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  calls    Call[]

  @@map("service_ai_configs")
}

model Contact {
  id             String    @id @default(uuid())
  tenantId       String
  fullName       String
  phone          String
  email          String?
  location       String?
  notes          String?   @db.Text
  consentGranted Boolean   @default(true)
  consentDate    DateTime  @default(now())
  consentSource  String?   @default("Website Enquiry / CSV Upload")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads     Lead[]
  customers Customer[]
  followUps FollowUp[]

  @@unique([tenantId, phone])
  @@index([tenantId, phone])
  @@map("contacts")
}

model Lead {
  id                 String        @id @default(uuid())
  tenantId           String
  contactId          String
  serviceId          String
  leadSource         String        @default("CSV Import")
  status             LeadStatus    @default(NEW_LEAD)
  interestLevel      InterestLevel @default(MEDIUM)
  aiCallingEligible  Boolean       @default(true)
  callAttempts       Int           @default(0)
  lastCallDate       DateTime?
  nextFollowUpDate   DateTime?
  qualificationNotes String?       @db.Text
  customFields       Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact           Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  service           Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  calls             Call[]
  followUps         FollowUp[]
  pipelineHistories SalesPipelineHistory[]
  customers         Customer[]

  @@index([tenantId, status])
  @@index([tenantId, serviceId])
  @@map("leads")
}

model LeadImportBatch {
  id          String   @id @default(uuid())
  tenantId    String
  serviceId   String?
  fileName    String
  totalRows   Int      @default(0)
  validRows   Int      @default(0)
  invalidRows Int      @default(0)
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows   LeadImportRow[]

  @@map("lead_import_batches")
}

model LeadImportRow {
  id               String           @id @default(uuid())
  batchId          String
  tenantId         String
  rowNumber        Int
  rawData          Json
  parsedName       String?
  parsedPhone      String?
  parsedService    String?
  validationStatus ValidationStatus @default(VALID)
  errorMessage     String?
  leadId           String?
  createdAt        DateTime         @default(now())

  batch LeadImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("lead_import_rows")
}

model Call {
  id                String      @id @default(uuid())
  tenantId          String
  leadId            String
  serviceId         String
  serviceAiConfigId String?
  externalCallId    String?     @unique
  callerNumber      String?
  recipientNumber   String
  status            CallStatus  @default(QUEUED)
  outcome           CallOutcome?
  durationSeconds   Int         @default(0)
  billableSeconds   Int         @default(0)
  recordingUrl      String?
  transcript        String?     @db.Text
  summary           String?     @db.Text
  objectionHandled  String?     @db.Text
  nextAction        String?
  callbackTime      DateTime?
  costAmount        Decimal     @default(0) @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead            Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceAiConfig ServiceAiConfig? @relation(fields: [serviceAiConfigId], references: [id], onDelete: SetNull)
  events          CallEvent[]
  usageLedger     AiUsageLedger?

  @@index([tenantId, status])
  @@index([tenantId, outcome])
  @@map("calls")
}

model CallEvent {
  id        String   @id @default(uuid())
  callId    String
  eventType String
  payload   Json
  timestamp DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("call_events")
}

model FollowUp {
  id           String           @id @default(uuid())
  tenantId     String
  leadId       String?
  contactId    String
  title        String
  description  String?          @db.Text
  type         FollowUpType     @default(CALLBACK)
  priority     FollowUpPriority @default(MEDIUM)
  dueDate      DateTime
  status       FollowUpStatus   @default(PENDING)
  outcomeNotes String?          @db.Text
  serviceId    String?
  stageId      String?
  currentStage String?
  meetingStatus String?
  assignedOwner String?          @default("AI Voice Assistant")
  callHistory  Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead    Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  service Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  stage   ServiceFollowUpStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("follow_ups")
}

model SalesPipelineHistory {
  id              String      @id @default(uuid())
  tenantId        String
  leadId          String
  fromStatus      LeadStatus?
  toStatus        LeadStatus
  reason          String?
  changedByUserId String?
  createdAt       DateTime    @default(now())

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead          Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedByUser User?  @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("sales_pipeline_history")
}

model Customer {
  id                 String   @id @default(uuid())
  tenantId           String
  contactId          String
  primaryServiceId   String?
  convertedLeadId    String?
  conversionDate     DateTime @default(now())
  totalContractValue Decimal  @default(0) @db.Decimal(12, 2)
  status             String   @default("ACTIVE")
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  primaryService Service? @relation(fields: [primaryServiceId], references: [id], onDelete: SetNull)
  convertedLead  Lead?    @relation(fields: [convertedLeadId], references: [id], onDelete: SetNull)

  @@unique([tenantId, contactId])
  @@map("customers")
}

model AiUsageLedger {
  id             String   @id @default(uuid())
  tenantId       String
  callId         String   @unique
  billableMinutes Decimal  @db.Decimal(10, 2)
  providerCost   Decimal  @db.Decimal(10, 2)
  billedToClient Decimal  @db.Decimal(10, 2)
  ratePerMinute  Decimal  @default(1.50) @db.Decimal(6, 2)
  currency       String   @default("INR")
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("ai_usage_ledger")
}

model Invoice {
  id                  String        @id @default(uuid())
  tenantId            String
  invoiceNumber       String        @unique
  billingPeriodStart  DateTime
  billingPeriodEnd    DateTime
  callingMinutes      Decimal       @default(0) @db.Decimal(10, 2)
  callingCharges      Decimal       @default(0) @db.Decimal(10, 2)
  subscriptionCharges Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount           Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount         Decimal       @default(0) @db.Decimal(10, 2)
  amountPaid          Decimal       @default(0) @db.Decimal(10, 2)
  status              InvoiceStatus @default(PENDING)
  dueDate             DateTime
  paidAt              DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("invoices")
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String
  invoiceId      String
  transactionRef String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  gateway        String        @default("Razorpay / Bank Transfer")
  status         PaymentStatus @default(SUCCESS)
  paymentDate    DateTime      @default(now())
  metaData       Json?
  createdAt      DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([entity])
  @@map("audit_logs")
}

model GlobalSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  category    String   @default("GENERAL")
  isEncrypted Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("global_settings")
}

model TelephonyConnection {
  id              String        @id @default(uuid())
  tenantId        String
  name            String
  providerType    String        // "SARVAM_MANAGED" | "BYOT_SIP_TRUNK" | "BYOT_CARRIER"
  providerName    String
  status          String        @default("VERIFIED") // "VERIFIED" | "PENDING_VERIFICATION" | "DISCONNECTED" | "ERROR"
  isVerified      Boolean       @default(true)
  config          Json?
  lastVerifiedAt  DateTime?
  lastSyncAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  phoneNumbers    PhoneNumber[]

  @@map("telephony_connections")
}

model PhoneNumber {
  id                  String               @id @default(uuid())
  tenantId            String?
  connectionId        String?
  providerNumberId    String?              @unique
  e164Number          String               @unique
  countryCode         String?              // ISO 3166-1 alpha-2 e.g. "US", "GB", "IN", "SG", "DE"
  countryName         String?
  region              String?
  callingCode         String?              // e.g. "+1", "+44", "+91", "+65"
  numberType          String               @default("LOCAL") // "LOCAL" | "TOLL_FREE" | "MOBILE" | "NATIONAL"
  providerStatus      String               @default("ACTIVE") // "ACTIVE" | "PENDING_VERIFICATION" | "FAILED" | "ARCHIVED" | "AVAILABLE"
  kycStatus           String?              // "VERIFIED" | "PENDING" | "NOT_REQUIRED" | "REJECTED"
  monthlyRent         Decimal?             @db.Decimal(10, 2)
  currency            String?              // e.g. "USD", "INR", "GBP", "EUR"
  renewalDate         DateTime?
  isByot              Boolean              @default(false)
  active              Boolean              @default(true)
  assignedAgentId     String?
  assignedServiceName String?
  allocatedAt         DateTime?
  lastSynchronizedAt  DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  connection          TelephonyConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@map("phone_numbers")
}

model TenantVoicePreference {
  id                    String   @id @default(uuid())
  tenantId              String   @unique
  preferredLanguage     String   @default("hi-IN")
  preferredVoice        String   @default("meera")
  voiceGender           String   @default("female")
  speakingSpeed         Float    @default(1.0)
  conversationTone      String   @default("CONSULTATIVE")
  greetingMessage       String   @db.Text
  businessIntroduction  String   @db.Text
  generalInstructions   String   @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("tenant_voice_preferences")
}

model CreditTransaction {
  id           String   @id @default(uuid())
  tenantId     String
  type         String   // CREDIT_PURCHASE | USAGE_DEDUCTION | REFUND | BONUS
  amount       Decimal  @db.Decimal(10, 2)
  balanceAfter Decimal  @db.Decimal(10, 2)
  description  String
  referenceId  String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@map("credit_transactions")
}

model SarvamVoiceSession {
  id                String    @id @default(uuid())
  tenantId          String
  userId            String?
  serviceId         String?
  sarvamOrgId       String
  sarvamWorkspaceId String
  sarvamAppId       String
  committedVersion  Int       @default(1)
  referenceId       String    @unique
  interactionId     String?
  mode              String    @default("voice") // voice | phone | chat
  status            String    @default("INITIATED") // INITIATED | CONNECTED | COMPLETED | FAILED | TIMED_OUT
  durationSeconds   Int       @default(0)
  billableMinutes   Decimal   @default(0) @db.Decimal(10, 2)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  transcript        Json?
  outputVariables   Json?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([referenceId])
  @@map("sarvam_voice_sessions")
}

model TenantAgentConfiguration {
  id                     String    @id @default(uuid())
  tenantId               String
  serviceId              String?
  version                Int       @default(1)
  sourceProfileVersion   Int       @default(1)
  status                 String    @default("DRAFT") // DRAFT | APPROVED | PUBLISHED | OUTDATED | ARCHIVED
  agentName              String
  agentRole              String
  organizationContext    String    @db.Text
  channel                String    @default("Outbound phone call over telephony")
  conversationObjectives Json
  openingGreeting        String    @db.Text
  qualificationQuestions Json
  requiredInfo           Json
  faqs                   Json
  objectionHandling      Json
  speakingStyle          Json
  followUpRules          Json
  humanEscalationRules   Json
  variables              Json
  outputFields           Json
  prohibitedClaims       Json
  missingInformation     Json?
  fullPrompt             String    @db.Text
  isOutdated             Boolean   @default(false)
  outdatedReason         String?
  generatedAt            DateTime  @default(now())
  approvedAt             DateTime?
  approvedBy             String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant   Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions AgentConfigurationVersion[]

  @@index([tenantId, status])
  @@map("tenant_agent_configurations")
}

model AgentConfigurationVersion {
  id              String   @id @default(uuid())
  configurationId String
  tenantId        String
  versionNumber   Int
  status          String
  snapshot        Json
  changeNotes     String?
  createdById     String?
  createdAt       DateTime @default(now())

  configuration TenantAgentConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@index([configurationId])
  @@index([tenantId])
  @@map("agent_configuration_versions")
}

model ServiceMarketingMaterial {
  id           String   @id @default(uuid())
  tenantId     String
  serviceId    String
  fileName     String
  fileType     String
  fileSize     Int?
  fileUrl      String?  @db.Text
  rawContent   String?  @db.Text
  extractedData Json?
  createdAt    DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([tenantId])
  @@map("service_marketing_materials")
}

model ServiceFollowUpStage {
  id                 String   @id @default(uuid())
  tenantId           String
  serviceId          String
  order              Int      @default(1)
  name               String
  triggerTiming      String
  questions          Json
  expectedResponse   String?  @db.Text
  nextAction         String
  callbackScheduling Boolean  @default(true)
  meetingScheduling  Boolean  @default(false)
  retryLimit         Int      @default(3)
  stopConditions     String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  service   Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  followUps FollowUp[]

  @@index([serviceId, order])
  @@index([tenantId])
  @@map("service_follow_up_stages")
}

model TenantIntegration {
  id                 String              @id @default(uuid())
  tenantId           String
  provider           IntegrationProvider
  status             IntegrationStatus   @default(NOT_CONNECTED)
  accountIdentifier  String?
  accountName        String?
  accessTokenEnc     String?             @db.Text
  refreshTokenEnc    String?             @db.Text
  tokenExpiresAt     DateTime?
  metadata           Json?
  lastSyncAt         DateTime?
  errorMessage       String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("tenant_integrations")
}




